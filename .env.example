# Copy to ".env" and fill in values (never commit .env).
# Spring Boot does not read .env by itself: export vars in your shell, use your IDE env file,
# or a tool like direnv. On Render, set the same keys in the service Environment UI.

# --- Supabase Postgres (Dashboard → Settings → Database) ---
# Use the host from "Connection string" / URI. Default database name is usually "postgres".
# Prefer the direct connection (port 5432) for Hibernate unless you know pooler compatibility.
DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_database_password

# If you created payments + orders tables in the SQL Editor, disable Flyway on both services
# so migrations are not applied twice to the same database.
SPRING_FLYWAY_ENABLED=false

# --- Kafka (not from Supabase; use local broker, a cloud Kafka, or payment-service profile "local" for no Kafka) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=
# KAFKA_SASL_JAAS_CONFIG=

# --- Optional: Supabase client (JS/app only; Java services above use DB_URL) ---
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=server_only_never_expose_to_browser
